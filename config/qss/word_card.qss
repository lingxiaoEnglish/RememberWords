
/* 核心单词复习卡片 */
QFrame#WordCard {
    background-color: '{{card_bg}}';
    border: 1px solid '{{border_color}}';
    border-radius: 12px;
}

QWidget#TextContainer {
    /* 格式：左上、右上、右下、左下 */
    /* 核心点：上方保持直角(0px)衔接，下方给 12px 圆角匹配父级 */
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
/*    border: 1px solid '{{border_color}}';*/
/*    background-color: #FF0000;*/
}

QLabel#CardCover {
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    background-color: '{{cover_bg}}';
    qproperty-alignment: 'AlignCenter'; /*设置居中对齐*/
}

/* 补充：单词卡片内部的文本精细微调（可选，利于未来单独调卡片字号） */
QLabel#CardTitle {
    font-size: 13px;
    color: '{{text_main}}';
    font-weight: bold;
    background: transparent;
}
QLabel#CardWord {
    font-size: 18px;
    font-weight: bold;
    color: #1E293B;
    background: transparent;
}
QLabel#CardNote {
    font-size: 13px;
    color: #64748B;
    background: transparent;
}
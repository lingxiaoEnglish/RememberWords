/* resources/style.qss */

QWidget {
    font-family: '{{FONT_FAMILY}}';
    background-color: '{{window_bg}}';
    color: '{{text_main}}';
}

QSplitter::handle {
    background-color: '{{border_color}}';
}

QWidget#LeftPanel {
    background-color: '{{left_panel_bg}}';
}

QLabel#LogoLabel {
    font-size: 20px;
    font-weight: bold;
    color: '{{text_main}}';
    margin-bottom: 20px;
    padding-left: 8px;
    background-color: transparent;
}

QListWidget#NavList {
    border: none;
    background-color: transparent;
}

QListWidget#NavList::item {
    padding: 12px 16px;
    font-size: 14px;
    color: '{{text_muted}}';
    border-radius: 6px;
    margin-bottom: 6px;
    background-color: transparent;
}

QListWidget#NavList::item:hover {
    color: '{{text_main}}';
    background-color: '{{nav_item_hover}}';
}

QListWidget#NavList::item:selected {
    background-color: '{{nav_item_active}}';
    color: #FFFFFF;
    font-weight: bold;
}

QStackedWidget#RightStack {
    background-color: '{{right_stack_bg}}';
    border-left: 1px solid '{{border_color}}';
}

QStackedWidget#RightStack QLabel {
    color: '{{text_muted}}';
    background-color: transparent;
}

/* 核心单词复习卡片 */
QFrame#WordCard {
    background-color: '{{card_bg}}';
    border: 1px solid '{{border_color}}';
    border-radius: 12px;
}

QLabel#CardCover {
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    background-color: '{{cover_bg}}';
}

/* 补充：单词卡片内部的文本精细微调（可选，利于未来单独调卡片字号） */
QLabel#CardTag {
    font-size: 11px;
    color: #3B82F6;
    font-weight: bold;
    background: transparent;
}
QLabel#CardWord {
    font-size: 18px;
    font-weight: bold;
    color: #1E293B;
    background: transparent;
}
QLabel#CardNote {
    font-size: 13px;
    color: #64748B;
    background: transparent;
}